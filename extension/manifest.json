{
  "manifest_version": 3,
  "name": "Tab Out",
  "version": "1.1.2",
  "description": "个人改造版新标签页：大时钟 + 搜索框 + 常用网站 + 标签页分组（基于 zarazhangrui/tab-out 改造）",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "favicon"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tab Out",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
